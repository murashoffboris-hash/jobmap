# ── Service discovery ──
SERVICE_NAME="JobMap"
APP_ENV=production

# ── Domains (set after DNS is configured) ──
PUBLIC_DOMAIN=example.by
API_DOMAIN=api.example.by

# ── PostgreSQL ──
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=job_service
POSTGRES_USER=job_service
POSTGRES_PASSWORD=CHANGE_ME

# ── Geoservices (internal) ──
NOMINATIM_URL=http://nominatim:8080
OSRM_URL=http://osrm:5000

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Auth ──
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──
CORS_ORIGINS=https://example.by

# ── S3-compatible storage ──
S3_ENDPOINT=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=job-service
