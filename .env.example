# JobMap environment variables — copy to .env and fill in real values
# Никогда не коммитить .env с реальными паролями!

# Service identity
SERVICE_NAME=JobMap
APP_ENV=development

# Domains
PUBLIC_DOMAIN=phone.service247.by
API_DOMAIN=api.phone.service247.by

# PostgreSQL — ОБЯЗАТЕЛЬНО задать уникальный пароль
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_service
POSTGRES_USER=job_service
POSTGRES_PASSWORD=<generate-with: openssl rand -base64 24>

# Geoservices
NOMINATIM_URL=http://nominatim:8080
OSRM_URL=http://osrm:5000

# Redis
REDIS_URL=redis://redis:6379/0

# Auth — ОБЯЗАТЕЛЬНО задать уникальный секрет
JWT_SECRET=<generate-with: openssl rand -base64 32>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (через запятую)
CORS_ORIGINS=http://localhost:3000

# S3 storage (MinIO) — ОБЯЗАТЕЛЬНО сменить дефолтные ключи
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=<generate-unique-key>
S3_SECRET_KEY=<generate-unique-key>
S3_BUCKET_NAME=job-service

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@service247.by
