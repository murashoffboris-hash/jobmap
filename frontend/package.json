{
  "name": "jobmap-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JobMap — кроссплатформенный сервис поиска работы (React + TypeScript + Capacitor + PWA + MapLibre)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
